---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="Christian Martos - Portafolio">
  <div
    class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden"
  >
    <div class="layout-container flex h-full grow flex-col">
      <Header />
      <main class="flex-1 px-4 sm:px-6 lg:px-10 py-10 sm:py-16">
        <div class="mx-auto max-w-7xl">
          <div class="flex flex-col gap-10 sm:gap-12">
            <div class="flex flex-col items-center text-center gap-3">
              <h1
                class="text-[#1D1D1F] dark:text-white text-4xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tighter"
              >
                Explora mi trabajo
              </h1>
              <p
                class="text-[#6E6E73] dark:text-gray-400 text-base sm:text-lg font-normal leading-normal max-w-2xl"
              >
                Una selección de mis proyectos en marketing, creación de
                contenido y visualización 3D. Cada uno diseñado con precisión y
                un objetivo claro.
              </p>
            </div>
            <div class="flex gap-2 sm:gap-3 p-1 justify-center flex-wrap">
              <button
                class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full px-4 sm:px-5 bg-primary text-white"
              >
                <p class="text-sm sm:text-base font-medium leading-normal">
                  Todos
                </p>
              </button>
              <button
                class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full px-4 sm:px-5 bg-gray-200/80 dark:bg-gray-700/80 text-[#1D1D1F] dark:text-gray-300 hover:bg-gray-300/80 dark:hover:bg-gray-600/80 transition-colors"
              >
                <p class="text-sm sm:text-base font-medium leading-normal">
                  Marketing
                </p>
              </button>
              <button
                class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full px-4 sm:px-5 bg-gray-200/80 dark:bg-gray-700/80 text-[#1D1D1F] dark:text-gray-300 hover:bg-gray-300/80 dark:hover:bg-gray-600/80 transition-colors"
              >
                <p class="text-sm sm:text-base font-medium leading-normal">
                  Creación de Contenido
                </p>
              </button>
              <button
                class="flex h-9 shrink-0 items-center justify-center gap-x-2 rounded-full px-4 sm:px-5 bg-gray-200/80 dark:bg-gray-700/80 text-[#1D1D1F] dark:text-gray-300 hover:bg-gray-300/80 dark:hover:bg-gray-600/80 transition-colors"
              >
                <p class="text-sm sm:text-base font-medium leading-normal">
                  Visualización 3D
                </p>
              </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
              <div
                class="group relative flex flex-col justify-end overflow-hidden rounded-xl bg-gray-200 dark:bg-gray-800 md:col-span-2 aspect-[16/9] sm:aspect-[2/1] p-6 sm:p-8"
              >
                <img
                  alt="Modern luxury residence with a pool at dusk."
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0WwJohYVCwofLeBifelJZrh9Oq-DugfvQZGUaprs8-BUkTGKMKU4fN2bj56P3L3rpNYK9MovY9OTghHPWV4r7ifrzqD7pEFWHXQtXRCmkFGwr3_UdOkVrc61qKO78G9LkaF7uhVeALFtNp3FQw2r1plGp35h_k3MTNRol4hc4hOWe2NGEShu0dn9S0Ion2ckTtiY2ma9eIN3F8fSg4KQOj37EH2QY0IwS0weNt-OQgBu-WNLYV6olKH2S9_AbG8r2MN_xDs0WQQ"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
                >
                </div>
                <div class="relative flex flex-col gap-2">
                  <p class="text-white/80 text-sm font-medium">
                    Visualización 3D
                  </p>
                  <h3 class="text-white text-2xl sm:text-3xl font-bold leading-tight">
                    Residencia de Lujo en Marbella
                  </h3>
                  <div
                    class="mt-2 h-0.5 w-0 bg-primary transition-all duration-300 group-hover:w-16"
                  >
                  </div>
                  <a
                    aria-label="Ver proyecto Residencia de Lujo en Marbella"
                    class="absolute inset-0"
                    href="#"></a>
                </div>
              </div>
              <div
                class="group relative flex flex-col justify-end overflow-hidden rounded-xl bg-gray-200 dark:bg-gray-800 aspect-square sm:aspect-[4/3] p-6 sm:p-8"
              >
                <img
                  alt="Team collaborating on a launch campaign in a modern office."
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuAb4lwJEziz2rHXGwZGkmu3YjOrkUVBT2-nD1luoyishG3fZs84tlJNdgDNrw5zK7_2er3boN4oe1brCQ1lVORqkR1tUbF9C1NcIi4jBYb5cP7-QX2z1_2--dsfXZ0NEJkzbdwRQUcUG13fnV16LEhugEGDgdNA7zEetcrcC4vRQUKAhVC7sZu3VqqfaMQHuaZC4kQ2KH1Q4LB7tRa44dszf-Fk6NBst-c7wsvWczZfp34LZz2Ew5WxqHxaiM4GzP66Bk6p-Mpp3g"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
                >
                </div>
                <div class="relative flex flex-col gap-2">
                  <p class="text-white/80 text-sm font-medium">Marketing</p>
                  <h3 class="text-white text-2xl sm:text-3xl font-bold leading-tight">
                    Campaña de Lanzamiento para Acme Corp
                  </h3>
                  <div
                    class="mt-2 h-0.5 w-0 bg-primary transition-all duration-300 group-hover:w-16"
                  >
                  </div>
                  <a
                    aria-label="Ver proyecto Campaña de Lanzamiento para Acme Corp"
                    class="absolute inset-0"
                    href="#"></a>
                </div>
              </div>
              <div
                class="group relative flex flex-col justify-end overflow-hidden rounded-xl bg-gray-200 dark:bg-gray-800 aspect-square sm:aspect-[4/3] p-6 sm:p-8"
              >
                <img
                  alt="Filming a product video for a modern tech gadget."
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB89tlwtUMJonPTYJCDjQMq-roD76H0B3MMVnsjTwMiPft37gx8bjBrSOyxqYBFnFwUInvtxFLtj39eXmADeo5qoPR7gQubEftbrNqW5rcpPV59dFiQfEe69JUwAmELV8ib7hau8aJfrhQ8iz9VhrE3jzQdpp1h6iOIbzwbONL27z_RuMOIYBqqLyC8TQnMZMGkkSi8DW30g9hEzlYj-sskXMbgJppXIvzPsLGMNhchSZlEwwkDmHBgThoLsbucDbKmHwFEmtQ3GA"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
                >
                </div>
                <div class="relative flex flex-col gap-2">
                  <p class="text-white/80 text-sm font-medium">
                    Creación de Contenido
                  </p>
                  <h3 class="text-white text-2xl sm:text-3xl font-bold leading-tight">
                    Video de Producto para Tech Gadget
                  </h3>
                  <div
                    class="mt-2 h-0.5 w-0 bg-primary transition-all duration-300 group-hover:w-16"
                  >
                  </div>
                  <a
                    aria-label="Ver proyecto Video de Producto para Tech Gadget"
                    class="absolute inset-0"
                    href="#"></a>
                </div>
              </div>
              <div
                class="group relative flex flex-col justify-end overflow-hidden rounded-xl bg-gray-200 dark:bg-gray-800 aspect-square sm:aspect-[4/3] p-6 sm:p-8"
              >
                <img
                  alt="Abstract 3D render of a futuristic commercial building."
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCuaRbRDGAEOMCgL6ATVEB1lK0M1xJcLU_Gv5rKx9nMoty4VqCGCgmz8aojO5yCdki5hNpq9ecVFjSCYiONgqNn_JphxgkgKvqkbzBjdYc5dtxpGHXvdEVDJYm3SxaQs7slr5s1jmSllW_rYFS-2y7zDLEAgDTU_8XpdQZhVvPU12L1arXMhrC7G5LknC-e9IPF-3_5-v4S0d79DWKItyPCV9quxv2kndhl14rifmjeUsnlYZ6gy7kV2CFv0G_AZniY-4ADGvVrng"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
                >
                </div>
                <div class="relative flex flex-col gap-2">
                  <p class="text-white/80 text-sm font-medium">
                    Visualización 3D
                  </p>
                  <h3 class="text-white text-2xl sm:text-3xl font-bold leading-tight">
                    Edificio Comercial Futura
                  </h3>
                  <div
                    class="mt-2 h-0.5 w-0 bg-primary transition-all duration-300 group-hover:w-16"
                  >
                  </div>
                  <a
                    aria-label="Ver proyecto Edificio Comercial Futura"
                    class="absolute inset-0"
                    href="#"></a>
                </div>
              </div>
              <div
                class="group relative flex flex-col justify-end overflow-hidden rounded-xl bg-gray-200 dark:bg-gray-800 aspect-square sm:aspect-[4/3] p-6 sm:p-8"
              >
                <img
                  alt="User interface design for a modern lifestyle application."
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuCoeNlsr3U1mxbyODIpuepd-_klX6YGTsC3V_kpyQC1iC9lLFh8JAUeFuaexUCuAunhTqMPZrcuXGkCLemid4vB5SQaI7dHDezDPheLH-rUtNWNu0rBrxjiYkgTkkmaJj9qY8sspXnSNdbKCtcgE77NsxqHbxSysC9wykmhNx4-zOwqVzhLdNrAanx0mym4ZFhdIUN7Bqqhs2Jlg3Pjt31feaFpCi6ZEzCV1RCwoy4ATvn5O0FiIxhH2Oyn-uXJtWlgUes2qXghgA"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
                >
                </div>
                <div class="relative flex flex-col gap-2">
                  <p class="text-white/80 text-sm font-medium">
                    Creación de Contenido
                  </p>
                  <h3 class="text-white text-2xl sm:text-3xl font-bold leading-tight">
                    Contenido de Marca para App de Lifestyle
                  </h3>
                  <div
                    class="mt-2 h-0.5 w-0 bg-primary transition-all duration-300 group-hover:w-16"
                  >
                  </div>
                  <a
                    aria-label="Ver proyecto Contenido de Marca para App de Lifestyle"
                    class="absolute inset-0"
                    href="#"></a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>
