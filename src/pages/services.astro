---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="Christian Martos - Servicios">
  <div
    class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden"
  >
    <div class="layout-container flex h-full grow flex-col">
      <Header />
      <main class="flex flex-1 justify-center py-5">
        <div
          class="layout-content-container flex flex-col max-w-6xl flex-1 px-4 sm:px-10"
        >
          <!-- Hero Section -->
          <section class="text-center py-16 sm:py-24">
            <h1
              class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tighter text-text-light-primary dark:text-text-dark-primary max-w-4xl mx-auto"
            >
              Soluciones que transforman tu visión en realidad
            </h1>
            <h2
              class="mt-4 text-lg sm:text-xl font-normal text-text-light-secondary dark:text-text-dark-secondary max-w-3xl mx-auto"
            >
              Marketing experto, creación de contenido y visualización 3D para
              llevar tu proyecto al siguiente nivel.
            </h2>
          </section>
          <!-- Services Section -->
          <div class="flex flex-col gap-8 sm:gap-12 md:gap-16">
            <!-- Marketing Estratégico -->
            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-white dark:bg-background-dark/50 p-8 sm:p-12 rounded-xl"
            >
              <div class="flex flex-col gap-4 order-2 md:order-1">
                <h3
                  class="text-3xl sm:text-4xl font-bold tracking-tight text-text-light-primary dark:text-text-dark-primary"
                >
                  Marketing Estratégico
                </h3>
                <p
                  class="text-base text-text-light-secondary dark:text-text-dark-secondary"
                >
                  Ayudamos a las marcas a crecer, alcanzar a su público y
                  aumentar su visibilidad a través de estrategias basadas en
                  datos que generan resultados medibles.
                </p>
                <ul
                  class="mt-4 space-y-3 text-text-light-secondary dark:text-text-dark-secondary"
                >
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Análisis de mercado y competencia
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Estrategia y optimización SEO
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Gestión de campañas de publicidad digital
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Marketing de contenidos y redes sociales
                  </li>
                </ul>
              </div>
              <div class="order-1 md:order-2">
                <img
                  class="w-full h-auto object-cover rounded-lg aspect-square sm:aspect-[4/3]"
                  data-alt="Una persona analizando gráficos de crecimiento en una tableta"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDiaz_6_75Ysd31Ourz51UhqAFzh3GU6apOWQUB8bkFzjksrZDxg7jrjEVzefs6Y14abZLecNEppdFPJiv9ytWsb5wbXs4NVZ_5Nd3EkHFxKjP6dZgFRmq_UuQMTz5020bRJL6J3ioYWUD516dz_ZDG9NgZ0CbxPLfPjFgp2sJCNDCjvM9dgn_hnwkZLHirm5uLx746SNZmSDBQ_EvUTaE8_3uinWdwNipM3e-I2PyNOGpqOc64ARycTvvVqO4Xbv7cy23oleepKg"
                />
              </div>
            </div>
            <!-- Creación de Contenido -->
            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-white dark:bg-background-dark/50 p-8 sm:p-12 rounded-xl"
            >
              <div>
                <img
                  class="w-full h-auto object-cover rounded-lg aspect-square sm:aspect-[4/3]"
                  data-alt="Mockup de alta calidad mostrando un catálogo corporativo y una tarjeta de visita"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDN8UzJX5ZtOTTzIGoiFaBHGfGvx-_zyAdnY7dbnaXc06iJ_sCTuZZDjkSiezSfHJWQCSS3_FeqihHa3RhvARcnwpGPN5WZp7iDt_MzVeejmPj4-iGM-nxPoEQBbuaCouB0HLTVJAABobpRuJh0oX_T81I-0fS5Om2ShOdCGAw268VhO4er-99s74jgilVh7Schqvp9EaoxQF3OkvFoesMtOf3rgfBJhMe9_GQsZnzicecy2y7eIPqUizQuAe6qFA9sfOPFBZQ2rA"
                />
              </div>
              <div class="flex flex-col gap-4">
                <h3
                  class="text-3xl sm:text-4xl font-bold tracking-tight text-text-light-primary dark:text-text-dark-primary"
                >
                  Creación de Contenido
                </h3>
                <p
                  class="text-base text-text-light-secondary dark:text-text-dark-secondary"
                >
                  Diseñamos comunicación visual profesional que transmite
                  confianza y valor, desde documentos corporativos hasta
                  imágenes de marca que capturan tu esencia.
                </p>
                <ul
                  class="mt-4 space-y-3 text-text-light-secondary dark:text-text-dark-secondary"
                >
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Diseño de presentaciones y catálogos
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Fotografía y vídeo de producto
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Desarrollo de identidad visual y branding
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Copywriting y redacción de contenidos
                  </li>
                </ul>
              </div>
            </div>
            <!-- Visualización 3D -->
            <div
              class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-white dark:bg-background-dark/50 p-8 sm:p-12 rounded-xl"
            >
              <div class="flex flex-col gap-4 order-2 md:order-1">
                <h3
                  class="text-3xl sm:text-4xl font-bold tracking-tight text-text-light-primary dark:text-text-dark-primary"
                >
                  Visualización Arquitectónica 3D
                </h3>
                <p
                  class="text-base text-text-light-secondary dark:text-text-dark-secondary"
                >
                  Convertimos planos e ideas en imágenes fotorrealistas que
                  venden, emocionan y comunican tu visión con una claridad y un
                  detalle impresionantes.
                </p>
                <ul
                  class="mt-4 space-y-3 text-text-light-secondary dark:text-text-dark-secondary"
                >
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Renders fotorrealistas de interiores y exteriores
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Recorridos virtuales y animaciones 3D
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Visualización de producto y mobiliario
                  </li>
                  <li class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary"
                      >check_circle</span
                    >Planos de planta 3D amueblados
                  </li>
                </ul>
              </div>
              <div class="order-1 md:order-2">
                <img
                  class="w-full h-auto object-cover rounded-lg aspect-square sm:aspect-[4/3]"
                  data-alt="Render 3D fotorrealista de un interior de lujo minimalista"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDq8zg6MF87LzIB1u6dbCOltkyz9IwoZzrMtqvmHJcul5KrnXU2e6ta23M_SdMqNj0DTQH_zZT9TECca6GW6i3WONsIEzcleEUZaOdnCetSPpLO6I4uUxMXTMgnF0bW_x-_72p3oQP6FSt40LaZiIjJ9rguVQGgperwChLyrQc_nJ7bVod8MlL1K5XUHkSaDkar0GjB0vmGLXhzUfMwCVqJkVFOreReQRR8FVhSWMqoJHkGPfc8wjZsbu8gmT6QuIhaokiD5LEchw"
                />
              </div>
            </div>
          </div>
          <!-- CTA Section -->
          <section class="@container py-16 sm:py-24">
            <div
              class="flex flex-col items-center justify-end gap-6 text-center"
            >
              <h2
                class="text-3xl font-bold tracking-tight text-text-light-primary dark:text-text-dark-primary @[480px]:text-4xl @[480px]:font-black @[480px]:tracking-tight max-w-2xl"
              >
                ¿Listo para empezar a construir tu visión?
              </h2>
              <p
                class="text-base font-normal text-text-light-secondary dark:text-text-dark-secondary max-w-2xl"
              >
                Hablemos de tu proyecto y de cómo podemos ayudarte a alcanzar
                tus objetivos.
              </p>
              <button
                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-5 @[480px]:h-12 @[480px]:px-6 bg-primary text-white text-sm font-bold tracking-tight @[480px]:text-base transition-opacity hover:opacity-90"
              >
                <span class="truncate">Contactar Ahora</span>
              </button>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>
</Layout>
