---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="Christian Martos - Marketing Digital y Visualización 3D">
  <Header />
  <main class="flex-grow">
    <div
      class="relative flex h-full min-h-[700px] flex-col items-center justify-center bg-cover bg-center bg-no-repeat text-center"
      data-alt="Modern architectural interior with abundant natural light and minimalist furniture."
      style="background-image: linear-gradient(rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.5) 100%), url('https://lh3.googleusercontent.com/aida-public/AB6AXuCVXj2ny0f0TZSm2ayqhppyyUrKklHvJ2k8mVAoV6udMZXPchn25aQul0zg2vkblP0Shp2hO0pFk_XO6GHzSwt3Ohc54oeANZXGdDbl5e9dGeZLsw3GzbcPr3ItMxXDc35z7J6djpQk4ZyPiOUXsuyxqMrwk5zivN4AxRO1Wms6-6DrLkWonxd_eaZgUAyK9r_05gtt4x4CvSswS0dPrrDo0dtqLAI9fe0Gu-Ra9Qn54zLcA2qN4dSnzEsOLgRaE3BjCRKxWSOfYg');"
    >
      <div class="flex flex-col gap-6 px-4">
        <div class="flex flex-col gap-2">
          <h1
            class="text-4xl font-black leading-tight tracking-tighter text-white md:text-6xl"
          >
            Ideas que se ven. Estrategias que funcionan.
          </h1>
          <p
            class="mx-auto max-w-2xl text-base font-normal text-slate-200 md:text-lg"
          >
            Marketing Digital, Creación de Contenido y Visualización 3D para
            marcas y proyectos.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-4">
          <button
            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-6 bg-primary text-white text-base font-bold leading-normal tracking-wide transition-opacity hover:opacity-90"
          >
            <span class="truncate">Ver mi Portafolio</span>
          </button>
          <button
            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg border border-solid border-white/50 bg-white/10 h-12 px-6 text-white text-base font-bold leading-normal tracking-wide backdrop-blur-sm transition-colors hover:bg-white/20"
          >
            <span class="truncate">Hablemos de tu Proyecto</span>
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>
